# Archivos subidos por usuarios: nunca ejecutar código ni servir páginas HTML
<IfModule mime_module>
    RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .pht
    RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .pht
</IfModule>

<FilesMatch "(?i)\.(php\d?|phtml|phar|pht|pl|py|cgi|sh|asp|aspx|jsp|html?|shtml|xhtml|htaccess)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    # El navegador no debe adivinar el tipo de archivo
    Header set X-Content-Type-Options "nosniff"

    # Un SVG puede llevar scripts: se sirve sin permitir ejecutarlos
    <FilesMatch "(?i)\.svgz?$">
        Header set Content-Security-Policy "default-src 'none'; img-src data:; style-src 'unsafe-inline'; sandbox"
    </FilesMatch>
</IfModule>

Options -Indexes
